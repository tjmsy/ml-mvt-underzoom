{
  "name": "ml-mvt-underzoom",
  "version": "0.2.0",
  "description": "MapLibre underzoom helper — serve MVT at a lower zoom than third-party PMTiles/XYZ sources provide",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjmsy/ml-mvt-underzoom.git"
  },
  "bugs": {
    "url": "https://github.com/tjmsy/ml-mvt-underzoom/issues"
  },
  "homepage": "https://github.com/tjmsy/ml-mvt-underzoom/",
  "author": {
    "name": "tjmsy"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite",
    "demo:build": "vite build",
    "bench": "npm run build && node scripts/bench-underzoom.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "pmtiles": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "pmtiles": {
      "optional": true
    }
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2",
    "polygon-clipping": "^0.15.7",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mvt",
    "mapbox-vector-tile",
    "maplibre",
    "pmtiles",
    "underzoom",
    "vector-tiles"
  ]
}
